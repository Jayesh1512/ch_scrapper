{
  "version": 2,
  "functions": {
    "api/scrape.js": {
      "maxDuration": 30
    },
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "index.html"
    },
    {
      "src": "/api/scrape",
      "dest": "api/scrape.js"
    },
    {
      "src": "/api",
      "dest": "api/index.js"
    },
    {
      "src": "/scrape",
      "dest": "api/scrape.js"
    }
  ]
}
